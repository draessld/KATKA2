# =========================================================================
#  Directories that don't belong in the repo
# =========================================================================
build/**
scripts/build/**
other/**
experiments/**
output/
# generated pipeline outputs (index dirs, digests, kernels, MEM tables)
*.index/
*_m[0-9]*_w[0-9]*
*_k[0-9]*
out.out

# =========================================================================
#  Generated tooling config (run.py / INSTALL.sh)
# =========================================================================
configure.json
configuration.json

# =========================================================================
#  Documents & images (papers, agreements, plots, screenshots)
# =========================================================================
*.pdf
*.png
*.jpg
*.jpeg
*.zip
*.tar
*.tar.gz
# keep the main result graph that README.md displays
!1000genomes_simulated_error_rate_1p_w_lines.png

# =========================================================================
#  Markdown — only README.md is tracked
# =========================================================================
*.md
!README.md
# Flip these to track the working docs instead:
# !CLAUDE.md
# !TODO.md
notes.md

# =========================================================================
#  C++ sources belong under scripts/ only; ignore stray/scratch .cpp
# =========================================================================
*.cpp
!scripts/**/*.cpp

# =========================================================================
#  Build artifacts & editor/OS cruft
# =========================================================================
a.out
*.out
*.o
*.gch
.vscode/
.DS_Store

# tests/test.txt and tests/test.pattern are tracked by default (no rule ignores them);
# generated outputs under tests/ are covered by the pipeline-output rules above.
